<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_view_form_only_hr" model="ir.ui.view">
        <field name="name">hr.leave.view.form.only.hr</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <!-- Filter HR-only leave types for non-HR managers.
                 When hr_only_visible=True  → ('hr_only'=True OR hr_only=False) → all types.
                 When hr_only_visible=False → ('hr_only'=False OR hr_only=False) → non-HR only. -->
            <xpath expr="//field[@name='holiday_status_id']" position="attributes">
                <attribute name="domain">['&amp;', '|', ('hr_only', '=', hr_only_visible), ('hr_only', '=', False), '|', ('requires_allocation', '=', 'no'), '&amp;', ('has_valid_allocation', '=', True), '|', ('allows_negative', '=', True), '&amp;', ('virtual_remaining_leaves', '>', 0), ('allows_negative', '=', False)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
