<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_contract_view_form_cba" model="ir.ui.view">
        <field name="name">hr.contract.form.cba</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='contract_type_id']" position="after">
                <field name="hr_cba_id"/>
                <field name="hr_cba_position_id" domain="[('hr_cba_id', '=', hr_cba_id)]"/>
            </xpath>
        </field>
    </record>
</odoo>
