#. module: s6r_hr_leave_type_employee_category
#: model:ir.model.fields,help:s6r_hr_leave_type_employee_category.field_hr_leave_type__restricted_category_ids
msgid ""
"Employee tags allowed to use this time off type. An employee holding at least "
"one of them may request it; the others may not. Leave empty for no "
"restriction at all."
msgstr ""
"Étiquettes employé autorisées à utiliser ce type de congé. Un employé portant "
"au moins l'une d'elles peut le demander, les autres non. Laisser vide pour "
"aucune restriction."

#. module: s6r_hr_leave_type_employee_category
#: model:ir.model.fields,help:s6r_hr_leave_type_employee_category.field_hr_leave__allowed_holiday_status_ids
#: model:ir.model.fields,help:s6r_hr_leave_type_employee_category.field_hr_leave_allocation__allowed_holiday_status_ids
#: model:ir.model.fields,help:s6r_hr_leave_type_employee_category.field_hr_leave_category_restriction_mixin__allowed_holiday_status_ids
msgid ""
"Technical field: the time off types the tags of the employee give access to. "
"Drives the domain of the time off type on the form."
msgstr ""
"Champ technique : les types de congés auxquels les étiquettes de l'employé "
"donnent accès. Pilote le domaine du type de congé sur le formulaire."

#. module: s6r_hr_leave_type_employee_category
#. odoo-python
#: code:addons/s6r_hr_leave_type_employee_category/models/hr_leave_category_restriction.py:0
msgid ""
"%(employee)s does not hold any of the employee tags the time off type "
"\"%(leave_type)s\" is reserved to (%(tags)s)."
msgstr ""
"%(employee)s n'a pas l'étiquette requise pour utiliser le type de congé "
"\"%(leave_type)s\" (%(tags)s)."

#. module: s6r_hr_leave_type_employee_category
#: model_terms:ir.ui.view,arch_db:s6r_hr_leave_type_employee_category.hr_leave_type_view_form_employee_category
msgid "No restriction"
msgstr "Aucune restriction"

